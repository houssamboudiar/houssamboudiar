---
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../site';

const nav = [
  { href: '/work/', label: 'Work' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) => path.startsWith(href);
---

<header class="header">
  <div class="wrap header__inner">
    <a class="logo" href="/">
      HB<span class="logo__dot" aria-hidden="true">_</span><span class="sr-only"> · {site.name}, home</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href={site.cv}>CV<span class="sr-only"> (PDF)</span></a>
        </li>
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
  .header {
    border-bottom: 1px solid var(--line);
    background: var(--bg);
  }
  .header__inner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 4rem;
  }
  .logo {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--text);
    text-decoration: none;
    padding: 0.5rem 0;
    margin-right: auto;
  }
  .logo__dot {
    color: var(--accent);
  }
  ul {
    display: flex;
    gap: clamp(0rem, 2vw, 1.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li + li {
    margin-top: 0;
  }
  nav a {
    display: inline-block;
    padding: 0.6rem 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    color: var(--muted);
    text-decoration: none;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--text);
  }
  nav a[aria-current='page'] {
    box-shadow: inset 0 -2px 0 var(--accent);
  }
</style>
