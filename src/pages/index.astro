---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CaseCard from '../components/CaseCard.astro';
import SpecTable from '../components/SpecTable.astro';
import { site } from '../site';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  url: site.url,
  email: `mailto:${site.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Algiers', addressCountry: 'DZ' },
  alumniOf: 'University of Constantine 2 – Abdelhamid Mehri',
  sameAs: [site.github, site.linkedin],
};
---

<Base
  title={`${site.name} · ${site.role}`}
  fullTitle
  description="Full-stack engineer in Algiers with 4+ years building Angular, React, NestJS and FastAPI products, plus LLM agents with LangGraph for on-premise systems. Open to relocation."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(personLd)} />

  <section class="hero">
    <div class="wrap">
      <span class="hud">{site.role} · {site.location}</span>
      <h1><span class="glitch" data-text={site.name}>{site.name}</span></h1>
      <p class="hero__line">
        I build web platforms and the LLM agents inside them, for on-premise systems where data
        stays local and every action is checked against the user's permissions.<span
          class="cursor"
          aria-hidden="true"></span>
      </p>
      <div class="prose">
        <p>
          For the last 4+ years at Smartest in Algiers I have shipped products for the oil &amp;
          gas and public-transport sectors: Angular and React frontends, NestJS and FastAPI
          backends on PostgreSQL, Keycloak single sign-on, and an AI assistant that runs on local
          models at offline sites. I care about access control, real-time data and tests that
          catch problems before customers do.
        </p>
        <p>I am looking for full-stack or AI engineering roles and I am open to relocation.</p>
      </div>
      <ul class="links">
        <li><a class="btn btn--primary" href={site.cv}>Download CV <span class="sr-only">(PDF)</span><span aria-hidden="true">↓</span></a></li>
        <li><a class="btn" href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a class="btn" href={site.github} rel="me">GitHub</a></li>
        <li><a class="btn" href={site.linkedin} rel="me">LinkedIn</a></li>
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="work-heading">
    <div class="wrap">
      <span class="hud">01 Selected work</span>
      <h2 id="work-heading" class="section__title">Case studies</h2>
      <div class="grid">
        {work.map((entry, i) => <CaseCard entry={entry} index={i} headingLevel="h3" />)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="stack-heading">
    <div class="wrap">
      <span class="hud">02 Stack</span>
      <h2 id="stack-heading" class="section__title">What I work with</h2>
      <div class="stack">
        <SpecTable
          rows={[
            ['AI / LLM', 'LangGraph, LangChain, RAG, pgvector, tool calling, human-in-the-loop, Ollama, vLLM'],
            ['Frontend', 'TypeScript, Angular, React, RxJS, TanStack, Tauri'],
            ['Backend', 'Python, FastAPI, Node.js, NestJS, PostgreSQL, OpenAPI, SSE, MQTT, OPC UA'],
            ['Security', 'Keycloak, OAuth2 / OpenID Connect, RBAC'],
            ['Delivery', 'Docker, CI/CD, Playwright, Testcontainers, WCAG 2.1 AA testing'],
          ]}
        />
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    padding-block: clamp(3rem, 10vw, 7rem) clamp(2.5rem, 7vw, 5rem);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  /* Faint static scanlines, hero only. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0 3px,
      color-mix(in srgb, var(--text) 3%, transparent) 3px 4px
    );
  }
  .hero .wrap {
    position: relative;
  }
  .hero h1 {
    margin-bottom: 0.4em;
  }
  .hero__line {
    max-width: 40ch;
    font-size: clamp(1.25rem, 2.6vw, 1.6rem);
    line-height: 1.4;
    margin-bottom: 1.5em;
  }
  .hero .links {
    margin-top: 2rem;
  }
  .section__title {
    margin-top: 0;
    margin-bottom: 1.5rem;
  }
  .grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 28rem), 1fr));
  }
  .stack {
    max-width: 52rem;
  }
</style>
