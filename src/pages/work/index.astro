---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CaseCard from '../../components/CaseCard.astro';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Work"
  description="Four case studies: a well integrity platform with an on-premise LLM assistant, a public-transport ticketing system, and two LangGraph agent projects."
>
  <div class="wrap section">
    <span class="hud">Work</span>
    <h1>Case studies</h1>
    <p class="prose muted lead">
      Two commercial products I work on at Smartest and two personal projects. Each page covers the
      problem, what I built, and how it turned out. The commercial ones are confidential, so they
      describe architecture and my role only.
    </p>
    <div class="grid">
      {work.map((entry, i) => <CaseCard entry={entry} index={i} />)}
    </div>
  </div>
</Base>

<style>
  .lead {
    margin-bottom: 2.5rem;
  }
  .grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 28rem), 1fr));
  }
</style>
